# Configuración para usar la aplicación en tu computadora: copia este archivo como .env.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Token de tu bot: te lo da @BotFather en Telegram (/newbot).
TELEGRAM_TOKEN=

# Recomendado: tu zona horaria, para que «hoy» sea tu día
# (lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
# Ejemplos: America/Argentina/Buenos_Aires, America/Mexico_City, America/Bogota, Europe/Madrid
ZONA_HORARIA=

# Opcional: IDs de Telegram que pueden usar el bot, separados por coma.
# Si lo dejas vacío, el bot queda para la primera persona que le escriba.
TELEGRAM_USUARIOS=

# Panel web. Con 127.0.0.1 solo se ve desde esta computadora (y no pide entrar).
# Con 0.0.0.0 también se ve desde tu red: entonces pide entrar con /panel,
# y URL_PANEL debe ser la dirección con la que lo abres (p. ej. http://192.168.1.20:8000).
HOST=127.0.0.1
PUERTO=8000
# URL_PANEL=

# Opcional: otra base de datos (ruta de SQLite o URL postgres://…). Por defecto datos/emociones.db
# BASE_DE_DATOS=
